// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// AppMixer felhőbe mentett projektek
model SavedProject {
  id             String   @id @default(uuid())
  name           String
  data           String   // a teljes projekt JSON-ként (sávok, blokkok, saját tartalmak)
  ownerTokenHash String?  // SHA-256 a tulajdonosi tokennel – felülírás/törlés védelem (nincs user-rendszer)
  published      Boolean  @default(false) // megosztási listában szerepel-e (a ?project=<id> link privát marad)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}